# === Database ===
# For docker-compose (service name "postgres"):
DATABASE_URL=postgres://bigface:bigface@postgres:5432/bigface
# For local dev (postgres running on your machine):
# DATABASE_URL=postgres://bigface:bigface@localhost:5432/bigface
POSTGRES_DB=bigface
POSTGRES_USER=bigface
POSTGRES_PASSWORD=bigface

# === Auth ===
# Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# === Server ===
PORT=4000
FRONTEND_URL=http://localhost:8080
AUTO_MIGRATE=true
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# === Stripe (https://dashboard.stripe.com) ===
# TODO(prod): replace with your real keys. App boots without them; payments show "not configured".
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Frontend build-time copy of the publishable key:
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_API_URL=
# Ready Player Me subdomain for the 3D avatar creator (create free at readyplayer.me)
VITE_RPM_SUBDOMAIN=demo

# PayPal Payouts — sends the 30% platform cut to the owner's PayPal.
# Get credentials at https://developer.paypal.com (sandbox first, then live).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_OWNER_EMAIL=
